{
  "spider": "https://example.com/spider.js;md5;1",
  "sites": [
    {
      "key": "site_a",
      "name": "测试站点A",
      "type": 0,
      "searchable": 1,
      "api": "https://api.example.com/api.php",
      "ext": "ext.json",
      "jar": "https://example.com/jar.jar"
    },
    {
      "key": "site_b",
      "name": "测试站点B",
      "type": 1,
      "searchable": 0,
      "api": "./relay/api.php",
      "ext": null,
      "jar": ""
    },
    {
      "key": "site_csp",
      "name": "CSP站点",
      "type": 3,
      "searchable": 0,
      "api": "https://csp.example.com/api.php",
      "jar": "https://csp.example.com/csp.jar"
    }
  ],
  "lives": [
    {
      "name": "综合直播",
      "type": 0,
      "url": "https://live.example.com/live.m3u8",
      "epg": "https://epg.example.com/epg.xml.gz",
      "logo": "https://example.com/logo.png",
      "playerType": 1
    }
  ],
  "parses": [
    {
      "name": "通用解析",
      "type": 0,
      "url": "https://parse.example.com/parse.php",
      "ext": { "flag": ["parse"] }
    }
  ],
  "doh": [
    { "name": "ali", "url": "https://dns.alidns.com/resolve" }
  ],
  "proxy": [
    { "enable": true, "type": "http", "host": "127.0.0.1", "port": 1080 }
  ],
  "rules": [
    { "host": "blocked.example.com", "regex": ".*" }
  ],
  "headers": {
    "User-Agent": "Mozilla/5.0 Test",
    "Referer": "https://example.com/"
  },
  "hosts": [
    "0.0.0.0 ads.example.com",
    "127.0.0.1 local.test"
  ],
  "ads": [
    "https://ads.example.com/",
    "https://tracker.example.com/"
  ]
}
